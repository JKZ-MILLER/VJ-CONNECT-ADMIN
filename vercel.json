{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/client", "destination": "/client/index.html" },
    { "source": "/c/:slug", "destination": "/client/index.html?slug=:slug" },
    { "source": "/c/:slug/", "destination": "/client/index.html?slug=:slug" }
  ]
}
